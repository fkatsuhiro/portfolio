---
import Layout from "../../layouts/Layout.astro";
import { Timeline, type TimelineItem } from "../../components/TimeLine";
import SkillBadges from "../../components/SkillBadges";
import ContributionGraph, { type ContributionCalendar } from "../../components/ContributionGraph";
import { useTranslations, type UIKey } from "../../i18n/ui";

const lang = "ko";
const t = useTranslations(lang);

const roles: { labelKey: UIKey; value: string }[] = [
  { labelKey: "about.roles.maintainer", value: "Yamada UI" },
  { labelKey: "about.roles.contributor", value: "WXT, Astro" },
];

const historyData: TimelineItem[] = [
  {
    date: "2017/4 ~ 2020/3",
    title: "미에 현립 요카이치 고등학교 보통과",
    description:
      "미에 현립 요카이치 고등학교 보통과에 재학했습니다.",
  },
  {
    date: "2020/4 ~ 2024/3",
    title: "치바 대학 이학부 물리학과",
    description:
      "치바 대학 이학부 물리학과에 재학했습니다.",
  },
  {
    date: "2024/4 ~ 2026/3",
    title:
      "도쿄 대학 대학원 공학계 연구과 바이오 엔지니어링 전공",
    description:
      "도쿄 대학 대학원 공학계 연구과 바이오 엔지니어링 전공에 재학했습니다.",
  },
  {
    date: "2026/3 ~",
    title: "주식회사 패스트 리테일링",
    description: "프론트엔드 엔지니어로서 개발 업무에 종사하고 있습니다.",
  },
].map((item) => ({
  date: item.date,
  title: item.title,
  description: item.description,
}));

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;

const contributionQuery = `
{
  viewer {
    contributionsCollection {
      contributionCalendar {
        totalContributions
        weeks {
          contributionDays {
            contributionCount
            date
          }
        }
      }
    }
  }
}
`;

let calendar: ContributionCalendar | null = null;

try {
  if (GITHUB_TOKEN) {
    const res = await fetch("https://api.github.com/graphql", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${GITHUB_TOKEN}`,
      },
      body: JSON.stringify({ query: contributionQuery }),
    });
    const json = await res.json() as any;
    calendar = json.data?.viewer?.contributionsCollection?.contributionCalendar ?? null;
  }
} catch (e) {
  console.error("Failed to fetch contribution data:", e);
}
---

<Layout title={t("meta.about.title")} description={t("meta.about.description")}>
  <main class="min-h-screen pt-20">
    <section class="px-4 pt-12 md:px-10 max-w-4xl mx-auto">
      <div
        class="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-[1.5rem] md:rounded-[2.5rem] p-8 md:p-14 shadow-sm hover:shadow-md transition-shadow"
      >
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
          Furuichi Katsuhiro
        </h1>

        <div
          class="mt-6 max-w-2xl space-y-4 text-base md:text-lg text-gray-700 dark:text-gray-300 leading-relaxed md:leading-loose"
        >
          <p>{t("about.bio")}</p>
          <p>
            <Fragment set:html={t("about.techSentence").replace(
              "React, Astro, TypeScript",
              '<span class="font-semibold text-blue-600 dark:text-blue-400">React, Astro, TypeScript</span>'
            )} />
          </p>

          <div class="flex flex-wrap gap-2">
            {
              roles.map((role) => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                  {t(role.labelKey)}
                  <span class="opacity-60">·</span>
                  {role.value}
                </span>
              ))
            }
          </div>

          <p class="text-sm md:text-base opacity-80">
            {t("about.hobbies")}
          </p>
        </div>

        <div class="mt-14 pt-10 border-t border-gray-100 dark:border-gray-800">
          <SkillBadges
            lang={lang}
            heading={t("about.skills.heading")}
            client:load
          />
        </div>

        <div class="mt-14 pt-10 border-t border-gray-100 dark:border-gray-800">
          <ContributionGraph
            calendar={calendar}
            heading={t("about.contributions.heading")}
            totalLabel={t("about.contributions.totalLabel")}
            noDataLabel={t("about.contributions.noData")}
            client:load
          />
        </div>
      </div>
    </section>
    <Timeline items={historyData} />
  </main>
</Layout>
