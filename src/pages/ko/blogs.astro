---
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/BlogCard";
import { fetchBlogPosts } from "../../lib/blog";
import { useTranslations } from "../../i18n/ui";

const t = useTranslations("ko");
const posts = await fetchBlogPosts();
---

<Layout title={t("meta.blogs.title")} description={t("meta.blogs.description")}>
  <main class="max-w-5xl mx-auto py-8 px-6 md:px-16">
    <div class="min-h-screen pt-20 bg-gray-50 dark:bg-gray-950">
      <div class="mb-12">
        <h1 class="text-4xl font-black text-slate-900 dark:text-white mb-2">
          {t("blogs.heading")}
        </h1>
        <p class="text-slate-500 dark:text-slate-400 font-medium">
          {t("blogs.subheading")}
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
        {
          posts.map((post) => (
            <BlogCard
              title={post.title}
              description={post.description}
              image={post.image}
              url={post.url}
              ariaLabelTemplate={t("blogs.readAria")}
              client:visible
            />
          ))
        }
      </div>
    </div>
  </main>
</Layout>
